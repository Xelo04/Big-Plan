generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  wants_newsletter Boolean  @default(false)

  role               Role               @default(USER)
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(FREE)
  subscriptionEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  simulations SavedSimulation[]
  
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SavedSimulation {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(80)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio?
  
  // Parametry wejściowe
  currentAge       Int
  expectedDeathAge Int
  workEndAge       Int
  statePensionAge  Int
  estimatedPension Float
  monthlyNeed      Float

  // Portfel
  stocksPct Int
  bondsPct  Int

  // Tryb kalkulatora
  knowsMonthlyAmount   Boolean
  userMonthlyInvestment Float?

  // Wyniki symulacji
  recommendedMonthlyPayment Float
  simulationSuccessRate     Float
  userSimulationSuccessRate Float?

  // Percentyle wykresów (JSON)
  recommendedChartPercentiles Json
  userChartPercentiles        Json?

  // Metadane symulacji
  totalSimulations Int @default(10000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_simulation")
}

model Portfolio {
  id           String   @id @default(cuid())
  simulationId String   @unique
  simulation   SavedSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  assets       PortfolioAsset[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portfolio")
}

model PortfolioAsset {
  id           String   @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name         String   @db.VarChar(120)
  ticker       String?  @db.VarChar(20)
  category     String   @db.VarChar(20) // "STOCKS" | "BONDS" | (przyszłość: "OTHER")

  quantity     Float
  averagePrice Float                    // cena zakupu w walucie instrumentu
  currentPrice Float                    // aktualna cena za sztukę (na razie ręcznie)
  currency     String   @default("PLN") @db.VarChar(10)
  customFxRate Float?                   // opcjonalny ręczny kurs → PLN

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([portfolioId])
  @@map("portfolio_asset")
}